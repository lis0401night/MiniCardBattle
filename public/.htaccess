# サービスワーカーファイルのキャッシュを完全に無効化する（即時更新を強制）
<Files "service-worker.js">
  Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</Files>

# index.htmlのキャッシュも無効化（新しいJSへの参照を即時反映）
<Files "index.html">
  Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</Files>

# クローラー・botからの /api/ への直接アクセスを遮断（多重防御）
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} ^.*/?api/ [NC]
  RewriteCond %{HTTP_USER_AGENT} (bot|crawl|spider|slurp|googlebot|bingbot|yandex|baidu|headless) [NC]
  RewriteRule ^ - [F,L]
</IfModule>