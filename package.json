{
  "name": "mini-card-battle",
  "private": true,
  "version": "0.2.5.2",
  "type": "module",
  "scripts": {
    "sync-version": "node sync_version.js && node scripts/generate_card_thumbnails.js && node scripts/compress_audio_all.js",
    "dev": "npm run sync-version && vite",
    "build": "npm run sync-version && vite build",
    "preview": "vite preview",
    "format": "node scripts/convert_assets_to_webp.js && node scripts/generate_card_thumbnails.js && node scripts/compress_audio_all.js && eslint --fix . && prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "dompurify": "^3.4.10",
    "firebase": "^12.11.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "sass": "^1.85.1",
    "vite": "^6.4.1",
    "vite-plugin-static-copy": "^2.2.0"
  }
}
