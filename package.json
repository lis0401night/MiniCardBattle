{
  "name": "mini-card-battle",
  "private": true,
  "version": "0.1.20",
  "type": "module",
  "scripts": {
    "sync-version": "node sync_version.js && node scripts/generate_card_thumbnails.js && node scripts/compress_audio_all.js",
    "dev": "npm run sync-version && vite",
    "build": "npm run sync-version && vite build",
    "preview": "vite preview",
    "format": "node scripts/convert_assets_to_webp.js && node scripts/generate_card_thumbnails.js && node scripts/compress_audio_all.js && eslint --fix . && prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "dompurify": "^3.4.10",
    "firebase": "^12.11.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^4.0.0"
  }
}
