{
  "name": "mini-card-battle",
  "private": true,
  "version": "0.3.9.17",
  "type": "module",
  "scripts": {
    "sync-version": "node sync_version.js && node scripts/generate_card_thumbnails.js && node scripts/compress_audio_all.js",
    "dev": "npm run sync-version && vite",
