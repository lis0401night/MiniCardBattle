# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase values from the console
# https://console.firebase.google.com/u/0/project/lanedefenders/overview

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=lanedefenders.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://lanedefenders-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=lanedefenders
VITE_FIREBASE_STORAGE_BUCKET=lanedefenders.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
